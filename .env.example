NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Conexão direta do Drizzle ORM (acesso a dados tipado, respeitando a RLS).
# Local (Supabase via Docker):  postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Produção: use a URL do POOLER DE TRANSAÇÕES do Supabase (porta 6543), com a senha
# do banco — nunca a service_role para queries comuns (ver ADR 0007).
DATABASE_URL=

# Integração com a LLM (teste de prompt da Fase 1). Chave de SERVIDOR: nunca use o
# prefixo NEXT_PUBLIC_ aqui, senão ela vai para o bundle do navegador.
OPENAI_API_KEY=
# Identificador do modelo. Os nomes mudam: confira na documentação da OpenAI antes de
# apontar para outro. Vazio usa o default do código (ver lib/ai).
OPENAI_MODEL=
# Tempo máximo de espera por resposta, em milissegundos. Passou disso, a chamada é
# encerrada e vira mensagem na tela. Vazio usa o default do código (60000).
OPENAI_TIMEOUT_MS=
# Teto de respostas de LLM por projeto (RNF-09), para que um defeito não vire fatura.
# É contado no servidor, na memória do processo, e volta a zero quando ele reinicia.
# Vazio usa o default do código (ver lib/ai/quota).
LLM_PROJECT_RESPONSES_MAX=
