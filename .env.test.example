# Modelo do .env.test.local — ambiente LOCAL de testes (Playwright + rota /dev/login).
#
#   cp .env.test.example .env.test.local
#
# Diferente do .env.local (que usa o Auth hospedado), aqui o app roda 100% contra o
# Supabase LOCAL: auth E banco em 127.0.0.1. É isso que permite entrar sem passar pela
# tela do Google — ver e2e/README.md.
#
# NÃO commite o .env.test.local (.env*.local é gitignored). Também não adianta copiar o
# de outra máquina: as chaves abaixo são geradas por instalação e mudam a cada
# `supabase db reset` com signing keys novas. Rode `supabase status` e cole as suas.

# `supabase status` → API URL
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# `supabase status` → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Igual para todo mundo rodando o Supabase local.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# `supabase status` → Secret key (sb_secret_...). É a service_role LOCAL, usada só para
# criar os usuários de teste. NUNCA use uma secret de produção aqui.
SUPABASE_SECRET_KEY=

# Usuário de teste do E2E (criado automaticamente, idempotente). A senha é local e
# descartável: qualquer valor serve, e não precisa ser a mesma que a de outra máquina.
E2E_USER_EMAIL=e2e@test.local
E2E_USER_PASSWORD=troque-esta-senha-local

# Opcional: e-mail da conta usada pela rota /dev/login. Default: dev@test.local.
# É uma conta SEPARADA da do E2E de propósito — a rota a promove a super-admin, e o
# fixture das specs precisa continuar sendo um usuário comum.
# DEV_USER_EMAIL=dev@test.local
